<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <link rel="stylesheet" href="/stylesheet.css" />
  </head>
  <body class="container">
    <header>
      <h1><%= title %></h1>
    </header>
    <div role="main">
      <table>
        <% for(var obj of content) { %>
        <tr>
          <th><%= obj.id %></th>
          <td><%= obj.name %></td>
          <td><%= obj.mail %></td>
          <td><%= obj.age %></td>
          <!-- <td><a href="/hello/show?id=<%= obj.id %>">詳細</a></td>
          <td><a href="/hello/edit?id=<%= obj.id %>">編集</a></td>
          <td><a href="/hello/delete?id=<%= obj.id %>">削除</a></td> -->
        </tr>
        <% } %>
      </table>
    </div>
  </body>
</html>
