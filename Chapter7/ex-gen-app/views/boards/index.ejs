<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <link rel="stylesheet" href="/stylesheet.css" />
  </head>
  <body class="container">
    <header>
      <h1><%= title %></h1>
    </header>
    <div role="main">
      <p class="h4">Welcome to <%= login.name %>!</p>
      <form action="/boards/add" method="post">
        <div class="row">
          <div class="col-md-10">
            <input type="text" name="msg" id="msg" class="form-control" />
          </div>
          <div class="col-2">
            <input type="submit" value="送信" class="btn btn-primary" />
          </div>
        </div>
      </form>
      <table class="table mt-5">
        <% for(let i in content) { %>
        <%- include("data_item", { val: content[i] }) %>
        <% } %>
      </table>

      <ul class="pagination justify-content-center">
        <li class="page-item">
          <a class="page-link" href="/boards/<%= page - 1 %>">&lt:&lt; prev</a>
        </li>
        <li class="page-item">
          <a class="page-link" href="/boards/<%= page + 1 %>">next &gt:&gt;</a>
        </li>
      </ul>
      <a href="/users/logout">ログアウト</a>
    </div>
  </body>
</html>
