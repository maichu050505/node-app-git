<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <link rel="stylesheet" href="/stylesheet.css" />
  </head>
  <body class="container">
    <header>
      <h1><%= title %></h1>
      <p><%= content %></p>
    </header>
    <div role="main">
      <table class="table">
        <tr>
          <th>ID</th>
          <td><%= mydata.id %></td>
        </tr>
        <tr>
          <th>Name</th>
          <td><%= mydata.name %></td>
        </tr>
        <tr>
          <th>Mail</th>
          <td><%= mydata.mail %></td>
        </tr>
        <tr>
          <th>Age</th>
          <td><%= mydata.age %></td>
        </tr>
      </table>
    </div>
  </body>
</html>
